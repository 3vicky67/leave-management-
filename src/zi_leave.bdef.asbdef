managed implementation in class zbp_i_leave unique;
strict ( 2 );
with draft;

define behavior for ZI_Leave alias Leave
persistent table zleave_req_db
draft table zleave_req_d
lock master
total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) ReqId;

  // RESTORED: Added EmpName to avoid activation errors since it is not in the DB table
  field ( readonly ) EmpName, TotalDays, Status, StatusCriticality, CreatedAt, CreatedBy, LastChangedAt, LastChangedBy, LocalLastChangedAt, ImageUrl;

  field ( mandatory ) EmpId, StartDate, EndDate, Reason;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare {
    validation validateDates;
  }

  action ( features : instance ) approveLeave result [1] $self;
  action ( features : instance ) rejectLeave result [1] $self;

  determination calculateDuration on modify { field StartDate, EndDate; }
  validation validateDates on save { field StartDate, EndDate; create; update; }
  determination autoApproveReject on modify { field TotalDays, EmpId; }
  determination setDefaultStatus on modify { create; }

  mapping for zleave_req_db
  {
    ReqId              = req_id;
    EmpId              = emp_id;
    ImageUrlInput      = image_url;
    Department         = department;
    StartDate          = start_date;
    EndDate            = end_date;
    TotalDays          = total_days;
    BalanceDays        = balance_days;
    Reason             = reason;
    Status             = status;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}