managed implementation in class zbp_i_leave unique;
strict ( 2 );
with draft;

define behavior for ZI_Leave alias Leave
persistent table zleave_req_db
draft table zleave_req_d
lock master
total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) ReqId;

  // ---> CHANGED: Added ImageUrl to readonly fields <---
  field ( readonly ) TotalDays, Status, StatusCriticality, CreatedAt, CreatedBy, LastChangedAt, LastChangedBy, LocalLastChangedAt, ImageUrl;

  field ( mandatory ) EmpId, StartDate, EndDate, Reason;

  // Draft Actions
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  // ---> CHANGED: Replaced checkLeaveBalance validation with autoApproveReject determination <---
  draft determine action Prepare {
    validation validateDates;
    determination autoApproveReject;
  }

  // Custom Actions
  action ( features : instance ) approveLeave result [1] $self;
  action ( features : instance ) rejectLeave result [1] $self;

  // Determinations & Validations
  determination calculateDuration on modify { field StartDate, EndDate; }
  validation validateDates on save { field StartDate, EndDate; create; update; }

  // ---> CHANGED: Added automatic approval/rejection determination on save <---
  determination autoApproveReject on save { field TotalDays, EmpId; }

  // Set default status to 'P' (Pending) on create
  determination setDefaultStatus on modify { create; }

  // ---------------------------------------------------------
  // FIELD MAPPING
  // ---------------------------------------------------------
  mapping for zleave_req_db
  {
    ReqId              = req_id;
    EmpId              = emp_id;
    ImageUrlInput      = image_url;

    Department         = department;
    StartDate          = start_date;
    EndDate            = end_date;
    TotalDays          = total_days;
    Reason             = reason;
    Status             = status;
    StatusCriticality  = status_criticality;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}